# Loom tenant. Server-side only: read by the Vite dev proxy, never shipped to the browser.
LOOM_API_URL=https://your-tenant.loom.tetralabs.us
LOOM_API_KEY=

# The Loom storage profile (Admin console -> Storage profiles, provider s3) that reads from the bucket below.
VITE_STORAGE_PROFILE=

# Cloudflare R2 bucket the browser uploads to via a presigned URL from the dev server (/api/presign).
# Must be the same bucket the storage profile reads from.
S3_BUCKET=
S3_REGION=auto
# R2 bucket -> Settings -> "S3 API", without the trailing /<bucket> path.
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 -> Manage R2 API Tokens -> Object Read & Write on this bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: folder inside the bucket. Default: loom-examples
# S3_KEY_PREFIX=loom-examples

# Optional: where the "Admin" link in the top bar points. Default: LOOM_API_URL.
# LOOM_ADMIN_URL=
